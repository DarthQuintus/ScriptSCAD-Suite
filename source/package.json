{
  "name": "scriptscad-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Build- und Testwerkzeuge für ScriptSCAD Studio (läuft nur im Container, nicht auf dem iPad)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tests/run-all.mjs",
    "shortcut": "cd shortcut && cherri 'ScriptSCAD KI.cherri' --share=anyone --signing-server=https://hubsign.routinehub.services/sign && rm -f *_processed.cherri *_unsigned.shortcut",
    "build:slicer": "node tools/build-slicer.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "cura-wasm": "1.5.2",
    "cura-wasm-definitions": "1.5.1",
    "esbuild": "0.24.2",
    "openscad-playground": "2.4.0",
    "three": "0.170.0"
  },
  "license": "GPL-3.0-or-later"
}
